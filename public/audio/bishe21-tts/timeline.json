      "start_sec": 0.0,
      "end_sec": 1.93,
      "start_frame": 0,
      "end_frame": 58
    },
    {
      "index": 2,
      "text": "有些题目看着简单，做起来才知道，功能不好设计，技术也不知道怎么选。",
      "audio": "s02.wav",
      "raw_dur": 5.2,
      "speech_start": 0.0,
      "speech_end": 4.79,
      "dur_sec": 4.79,
      "cps": 6.89,
      "start_sec": 1.99,
      "end_sec": 6.78,
      "start_frame": 60,
      "end_frame": 203
    },
    {
      "index": 3,
      "text": "比如养老管理系统，只做老人表的增删改查，就是普通的信息管理。",
      "audio": "s03.wav",
      "raw_dur": 4.66,
      "speech_start": 0.0,
      "speech_end": 4.29,
      "dur_sec": 4.29,
      "cps": 6.99,
      "start_sec": 6.84,
      "end_sec": 11.13,
      "start_frame": 205,
      "end_frame": 334
    },
    {
      "index": 4,
      "text": "但同一个题目换个做法，围绕社区养老服务走完一整条业务链。",
      "audio": "s04.wav",
      "raw_dur": 4.14,
      "speech_start": 0.04,
      "speech_end": 3.73,
      "dur_sec": 3.69,
      "cps": 7.59,
      "start_sec": 11.19,
      "end_sec": 14.88,
      "start_frame": 336,
      "end_frame": 446
    },
    {
      "index": 5,
      "text": "老人预约，管理员审核，智能派单，护理员上门服务。",
      "audio": "s05.wav",
      "raw_dur": 4.62,
      "speech_start": 0.0,
      "speech_end": 4.21,
      "dur_sec": 4.21,
      "cps": 5.7,
      "start_sec": 14.94,
      "end_sec": 19.15,
      "start_frame": 448,
      "end_frame": 574
    },
    {
      "index": 6,
      "text": "服务完评价，系统还会自动预警，这才叫真业务。",
      "audio": "s06.wav",
      "raw_dur": 3.78,
      "speech_start": 0.0,
      "speech_end": 3.39,
      "dur_sec": 3.39,
      "cps": 6.49,
      "start_sec": 19.21,
      "end_sec": 22.6,
      "start_frame": 576,
      "end_frame": 678
    },
    {
      "index": 7,
      "text": "定题之前，先查学校的往届毕设和相关论文。",
      "audio": "s07.wav",
      "raw_dur": 3.04,
      "speech_start": 0.0,
      "speech_end": 2.75,
      "dur_sec": 2.75,
      "cps": 7.27,
      "start_sec": 22.66,
      "end_sec": 25.41,
      "start_frame": 680,
      "end_frame": 762
    },
    {
      "index": 8,
      "text": "查的重点，不是完全不能重复。",
      "audio": "s08.wav",
      "raw_dur": 2.5,
      "speech_start": 0.0,
      "speech_end": 2.11,
      "dur_sec": 2.11,
      "cps": 6.64,
      "start_sec": 25.47,
      "end_sec": 27.58,
      "start_frame": 764,
      "end_frame": 827
    },
    {
      "index": 9,
      "text": "而是找到自己的切入点，比如把派单规则做成你的创新点。",
      "audio": "s09.wav",
      "raw_dur": 3.88,
      "speech_start": 0.0,
      "speech_end": 3.49,
      "dur_sec": 3.49,
      "cps": 7.45,
      "start_sec": 27.64,
      "end_sec": 31.13,
      "start_frame": 829,
      "end_frame": 934
    },
    {
      "index": 10,
      "text": "第二个坑是范围太大，用户、订单、支付、统计全想做。",
      "audio": "s10.wav",
      "raw_dur": 5.56,
      "speech_start": 0.0,
      "speech_end": 5.17,
      "dur_sec": 5.17,
      "cps": 4.84,
      "start_sec": 31.19,
      "end_sec": 36.36,
      "start_frame": 936,
      "end_frame": 1091
    },
    {
      "index": 11,
      "text": "先砍到一条核心业务链，再逐步往外扩。",
      "audio": "s11.wav",
      "raw_dur": 3.02,
      "speech_start": 0.0,
      "speech_end": 2.61,
      "dur_sec": 2.61,
      "cps": 6.9,
      "start_sec": 36.42,
      "end_sec": 39.03,
      "start_frame": 1093,
      "end_frame": 1171
    },
    {
      "index": 12,
      "text": "技术路线要匹配需求。",
      "audio": "s12.wav",
      "raw_dur": 1.46,
      "speech_start": 0.0,
      "speech_end": 1.23,
      "dur_sec": 1.23,
      "cps": 8.13,
      "start_sec": 39.09,
      "end_sec": 40.32,
      "start_frame": 1173,
      "end_frame": 1210
    },
    {
      "index": 13,
      "text": "管理系统用SpringBoot加Vue3加MySQL就够用。",
      "audio": "s13.wav",
      "raw_dur": 2.88,
      "speech_start": 0.0,
      "speech_end": 2.67,
      "dur_sec": 2.67,
      "cps": 11.24,
      "start_sec": 40.38,
      "end_sec": 43.05,
      "start_frame": 1211,
      "end_frame": 1292
    },
    {
      "index": 14,
      "text": "数据分析类项目再考虑Python，技术不是越多越好。",
      "audio": "s14.wav",
      "raw_dur": 3.32,
      "speech_start": 0.0,
