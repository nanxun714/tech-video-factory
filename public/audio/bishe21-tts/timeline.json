  "sentences": [
    {
      "index": 1,
      "text": "毕设选题，千万别急着定。",
      "audio": "s01.wav",
      "raw_dur": 2.32,
      "speech_start": 0.0,
      "speech_end": 1.93,
      "dur_sec": 1.93,
